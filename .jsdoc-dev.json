{
  "opts": {
    "pedantic": true,
    "template": "node_modules/kung-foodoc/template",
    "private": true
  },
  "source": {
    "include": [".", "lib"]
  },
  "plugins": ["plugins/markdown"],
  "markdown": {
    "tags": [
      "deprecated",
      "todo"
    ]
  },
  "templates": {
    "cleverLinks": true,
    "systemName": "NexusHoratio",
    "systemSummary": "A userscript library (developer variant docs)",
    "copyright": "",
    "dateFormat": "YYYY-MM-DD HH:mm",
    "inlineNav": true
  }
}
